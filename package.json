{
	"name": "n8n-nodes-xposedornot",
	"version": "0.1.1",
	"description": "n8n community node for XposedOrNot: check email addresses and domains for data breach exposure",
	"license": "MIT",
	"homepage": "https://github.com/XposedOrNot/XposedOrNot-n8n#readme",
	"bugs": {
		"url": "https://github.com/XposedOrNot/XposedOrNot-n8n/issues"
	},
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"xposedornot",
		"data-breach",
		"breach-monitoring",
		"security"
	],
	"author": {
		"name": "XposedOrNot",
		"email": "deva@xposedornot.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/XposedOrNot/XposedOrNot-n8n.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test \"test/**/*.test.js\"",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/XposedOrNotApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/XposedOrNot/XposedOrNot.node.js",
			"dist/nodes/XposedOrNot/XposedOrNotTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
