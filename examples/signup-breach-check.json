{
	"name": "Check every new signup email for breaches",
	"nodes": [
		{
			"parameters": {
				"httpMethod": "POST",
				"path": "new-signup",
				"options": {}
			},
			"id": "5b1f0c7e-3a41-4a57-9d0c-1f6c2a7e9b01",
			"name": "New Signup",
			"type": "n8n-nodes-base.webhook",
			"typeVersion": 2,
			"position": [0, 0],
			"webhookId": "5b1f0c7e-3a41-4a57-9d0c-1f6c2a7e9b10"
		},
		{
			"parameters": {
				"resource": "email",
				"operation": "checkBreaches",
				"email": "={{ $json.body.email }}"
			},
			"id": "5b1f0c7e-3a41-4a57-9d0c-1f6c2a7e9b02",
			"name": "Check Breaches",
			"type": "n8n-nodes-xposedornot.xposedOrNot",
			"typeVersion": 1,
			"position": [220, 0]
		},
		{
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "strict",
						"version": 2
					},
					"conditions": [
						{
							"id": "5b1f0c7e-3a41-4a57-9d0c-1f6c2a7e9b11",
							"leftValue": "={{ $json.breached }}",
							"rightValue": "",
							"operator": {
								"type": "boolean",
								"operation": "true",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			},
			"id": "5b1f0c7e-3a41-4a57-9d0c-1f6c2a7e9b03",
			"name": "Breached?",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [440, 0]
		},
		{
			"parameters": {
				"select": "channel",
				"channelId": {
					"__rl": true,
					"mode": "name",
					"value": "#security"
				},
				"text": "=New signup {{ $json.email }} appears in {{ $json.breach_count }} known breaches, including {{ $json.breaches.slice(0, 10).join(', ') }}",
				"otherOptions": {}
			},
			"id": "5b1f0c7e-3a41-4a57-9d0c-1f6c2a7e9b04",
			"name": "Tell Security Channel",
			"type": "n8n-nodes-base.slack",
			"typeVersion": 2.3,
			"position": [660, -100]
		}
	],
	"connections": {
		"New Signup": {
			"main": [[{ "node": "Check Breaches", "type": "main", "index": 0 }]]
		},
		"Check Breaches": {
			"main": [[{ "node": "Breached?", "type": "main", "index": 0 }]]
		},
		"Breached?": {
			"main": [[{ "node": "Tell Security Channel", "type": "main", "index": 0 }], []]
		}
	},
	"settings": {
		"executionOrder": "v1"
	}
}
